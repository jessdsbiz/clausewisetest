# Copy this file to .env and fill in your real values.
# .env is git-ignored. Never put these values in files under public/.

# Which AI answers: claude (default) or nvidia (the old NVIDIA Build models, as a fallback)
AI_PROVIDER=claude

# Claude API (console.anthropic.com -> API keys)
ANTHROPIC_API_KEY=
# Summary, plan, chatbot, translations, comics and photos: Haiku is the fastest and cheapest
ANTHROPIC_MODEL=claude-haiku-5-5
# The risk check (its own setting; Sonnet ran past the 30-second function limit)
ANTHROPIC_RISK_MODEL=claude-haiku-5-5

# NVIDIA Build, only used when AI_PROVIDER=nvidia
NVIDIA_API_KEY=nvapi-your-key-here

# Supabase -> Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Azure AI Speech (read-aloud audio in English, 中文, Bahasa Melayu and தமிழ்). Leave empty to use the device voice.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
