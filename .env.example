# Copy this file to .env and fill in your real values.
# .env is git-ignored. Never put these values in files under public/.

# Which AI answers: claude (default) or nvidia (the old NVIDIA Build models, as a fallback)
AI_PROVIDER=claude

# Claude API (console.anthropic.com -> API keys)
ANTHROPIC_API_KEY=
# Summary, plan, chatbot, translations, comics and photos: Haiku is the fastest and cheapest
ANTHROPIC_MODEL=claude-haiku-5-5
# The risk check only: Sonnet finds and quotes warning signs more reliably
ANTHROPIC_RISK_MODEL=claude-sonnet-5-5

# NVIDIA Build, only used when AI_PROVIDER=nvidia
NVIDIA_API_KEY=nvapi-your-key-here

# Supabase -> Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
