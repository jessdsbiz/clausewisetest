# Copy this file to .env and fill in your own values. .env is git-ignored: never commit it.
# This file lists every variable name the app reads. Leave the values empty here.

# ---- Which AI answers ----
# claude (default) or nvidia (the NVIDIA Build models, as a fallback)
AI_PROVIDER=

# ---- Claude API (console.anthropic.com -> API keys) ----
ANTHROPIC_API_KEY=
# Model names (optional; the app's defaults are claude-haiku-5-5)
ANTHROPIC_MODEL=
ANTHROPIC_RISK_MODEL=

# ---- NVIDIA Build (the second AI that checks Claude's work; also the fallback provider) ----
NVIDIA_API_KEY=
# Optional model overrides (leave empty for the defaults)
NVIDIA_TEXT_MODEL=
NVIDIA_VISION_MODEL=
NVIDIA_RISKS_MODEL=
NVIDIA_SUMMARY_MODEL=
NVIDIA_ASK_MODEL=
NVIDIA_COMIC_MODEL=
NVIDIA_TAILOR_MODEL=
NVIDIA_TRANSLATE_MODEL=
NVIDIA_DECIDE_MODEL=
NVIDIA_CHECK_MODEL=
NVIDIA_VERIFY_MODEL=
# claude = skip NVIDIA and use Claude as the checker (optional)
SECOND_CHECKER=

# ---- Azure AI Speech (read-aloud audio in English, 中文, Bahasa Melayu and தமிழ்) ----
# Leave both empty to use the device voice only.
AZURE_SPEECH_KEY=
# The region code that matches the key, for example eastasia
AZURE_SPEECH_REGION=

# ---- Supabase (Project Settings -> API) ----
SUPABASE_URL=
# Server-side only. Never put this in a file under public/.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Optional ----
# Set to any value to log the steps of the ask function in netlify dev (leave empty normally)
CLAUSEWISE_DEBUG=
